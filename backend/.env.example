# ==============================================================================
# BharatMaterials Backend — Environment Configuration
# Copy this file to .env and adjust values for your local setup.
# NEVER commit the .env file to version control.
# ==============================================================================

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
AI_MODE=mock

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
# Default matches docker-compose.yml; change if using native PostgreSQL
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nmat_db

# Optional: Direct connection string override (if set, overrides individual fields above)
# DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5432/nmat_db

# --- CORS (comma-separated origins allowed by the backend) ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
