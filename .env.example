# ==============================================================================
# N-MAT (SIH 26099) - Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS: Copy this file to .env for local development.
# NEVER commit .env or any file containing real secrets to version control.
# ==============================================================================

# --- Global Environment ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL) Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=nmat_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database Connection URI
DATABASE_URL=postgresql://postgres:replace_with_secure_password@localhost:5432/nmat_db

# --- Backend (FastAPI) Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=replace_with_generated_secure_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI / ML Engine Configuration ---
# AI_MODE: "mock" (default during Phases 0-5) or "real" (Phases 6-8 with trained models)
AI_MODE=mock
ML_SERVICE_HOST=localhost
ML_SERVICE_PORT=8001
ML_CONFIDENCE_THRESHOLD=0.75

# --- Frontend (Next.js) Configuration ---
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser runtime
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="N-MAT: National Material Intelligence Platform"
NEXT_PUBLIC_DEMO_MODE=true
